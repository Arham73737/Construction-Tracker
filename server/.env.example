PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:8080,http://localhost:5173
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_string_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_string_min_32_chars
